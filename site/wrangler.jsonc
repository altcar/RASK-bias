{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rask-bias",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": false
  },
  "observability": {
    "enabled": true
  }
}
